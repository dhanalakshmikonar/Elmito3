# Copy to .env for local development. Never commit .env.

# --- Django ---
# Local: leave as is. Production: set DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-generate-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# --- Database (SQLite locally and in production) ---
# Local development can use sqlite:///db.sqlite3 (or omit DATABASE_URL for BASE_DIR/db.sqlite3).
DATABASE_URL=sqlite:///db.sqlite3
# Render: mount a persistent disk at /var/data and set DATABASE_URL=sqlite:////var/data/db.sqlite3.

# --- Razorpay ---
# Dashboard > Account & Settings > API Keys. Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks. A secret YOU choose when creating the webhook (different from the key secret).
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (order notifications, built in the notifications phase) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your own number that receives new-order alerts, with country code, e.g. 919876543210.
# Also used for the public "Chat on WhatsApp" links on the site.
WHATSAPP_PROVIDER_NUMBER=

# --- Email ---
EMAIL_API_KEY=
EMAIL_FROM=EL MITO <no-reply@example.com>

# --- Checkout ---
# before_payment = customer confirms an emailed code before paying | none = no order OTP
ORDER_OTP_STAGE=before_payment

# --- Production only ---
SECURE_SSL_REDIRECT=True
# Render only: use a persistent disk mounted at /var/data.
# MEDIA_ROOT=/var/data/media
# SERVE_MEDIA=True

# --- Product images (REQUIRED on Render) ---
# Render's disk is erased on every restart/deploy/idle spin-down, so uploaded images must live elsewhere.
# Free Cloudinary account -> Dashboard -> "API Environment variable". Looks like:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Storefront design ---
# editorial (default) = the editorial theme in themes/editorial/.  classic = the original design.
# Switching only changes templates/CSS/JS; the backend is identical.
ELMITO_THEME=editorial
